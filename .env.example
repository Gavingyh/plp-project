# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys. THIS file is tracked, so every
# value here must stay a placeholder. It did not: real NewsAPI and Alpha
# Vantage keys sat in this file from the first commit until 2026-09-11, which
# means they are still in the git history and must be treated as burned. See
# docs/HANDOFF.md.
# See API_KEYS.md for step-by-step instructions on getting each key below.

# --- NewsAPI (https://newsapi.org/register) ---
# Optional manual-update source. Configure on the API host, then restart the API.
# Missing/placeholder keys disable NewsAPI and exclude it from All available sources.
NEWSAPI_KEY=your_newsapi_key_here

# --- Alpha Vantage (https://www.alphavantage.co/support/#api-key) ---
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# --- Reddit (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent — replace "your_username" below.
REDDIT_USER_AGENT=plp-practice-module/0.1 by u/your_username

# --- Streamlit connection to FastAPI (dashboard/api_client.py) ---
# Defaults to http://127.0.0.1:8000; PLP_API_PORT overrides the default port.
# PLP_API_URL overrides the complete address, e.g. http://api:8000 in Docker.
# PLP_API_URL=http://127.0.0.1:8000

# --- Logging / debugging (config/logging_config.py) ---
# LOG_LEVEL controls console verbosity. The log FILE always captures DEBUG
# regardless, so an unattended overnight run stays diagnosable afterwards.
# DEBUG=true is shorthand for LOG_LEVEL=DEBUG and additionally stops
# third-party libraries (transformers, urllib3, httpx...) being silenced —
# use it when you need to see HTTP calls or model-loading detail.
# LOG_LEVEL=INFO
# DEBUG=false
# LOG_FILE=data/logs/plp.log     # set to "none" to disable file logging

# --- Chatbot backend (chatbot/backends/) ---
# Leave ALL of ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY blank to
# run the chatbot entirely locally via Ollama (no key, no cost — see README
# "Running the chatbot" section). Fill in any one to use that frontier model
# instead; if more than one is set, auto-detect prefers Claude, then OpenAI,
# then Gemini (see chatbot/backends/__init__.py). CHATBOT_BACKEND overrides
# auto-detection entirely if set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# CHATBOT_BACKEND=ollama
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible provider, e.g. Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1 with a Groq key above and
#   OPENAI_MODEL=openai/gpt-oss-120b (or llama-3.3-70b-versatile, qwen/qwen3.8-27b)
# GEMINI_MODEL=gemini-3.8-flash   # or GEMINI_CHAT_MODEL; the key is for the chatbot only
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
