# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys. THIS file is tracked, so every
# value here must stay a placeholder. It did not: real NewsAPI and Alpha
# Vantage keys sat in this file from the first commit until 2026-09-11, which
# means they are still in the git history and must be treated as burned. See
# docs/HANDOFF.md.
# See API_KEYS.md for step-by-step instructions on getting each key below.

# --- NewsAPI (https://newsapi.org/register) ---
# Optional manual-update source. Configure on the API host, then restart the API.
# Missing/placeholder keys disable NewsAPI and exclude it from All available sources.
NEWSAPI_KEY=your_newsapi_key_here

# --- Alpha Vantage (https://www.alphavantage.co/support/#api-key) ---
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# --- Reddit (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent — replace "your_username" below.
REDDIT_USER_AGENT=plp-practice-module/0.1 by u/your_username

# --- Streamlit connection to FastAPI (dashboard/api_client.py) ---
# Defaults to http://127.0.0.1:8000; PLP_API_PORT overrides the default port.
# PLP_API_URL overrides the complete address, e.g. http://api:8000 in Docker.
# PLP_API_URL=http://127.0.0.1:8000

# --- Docker (docker compose up --build) ---
# Place the supplied ZIP at data/data.zip. Setup restores missing runtime files.
# Public FinBERT and MiniLM downloads need no token. Search vectors are built
# automatically if absent from the ZIP. These overrides are optional.
# Host ports; change them to run alongside the native setup.
# PLP_API_PORT=8000
# PLP_DASHBOARD_PORT=8501
# Host folders; paths are relative to the Compose file unless absolute.
# PLP_DATA_DIR=./data
# PLP_MODELS_DIR=./models
# Alternative to supplying the ZIP locally: a direct HTTPS download link.
# PLP_DATA_URL=
# PLP_DATA_TOKEN=
# PLP_DATA_SHA256=
# HF_TOKEN=
# Evaluation judge only (not needed for the app):
# PLP_EXTRA_OLLAMA_MODELS=qwen3:4b
# Docker warms the intent model before starting the UI; CPU-only cold loads are slow.
# PLP_WARM_INTENT=1
# CHATBOT_INTENT_TIMEOUT=180   # Docker default; native default remains 60 seconds
# For native Mac Ollama use compose.native-ollama.yaml; no URL override needed.

# --- Logging / debugging (config/logging_config.py) ---
# LOG_LEVEL controls console verbosity. The log FILE always captures DEBUG
# regardless, so an unattended overnight run stays diagnosable afterwards.
# DEBUG=true is shorthand for LOG_LEVEL=DEBUG and additionally stops
# third-party libraries (transformers, urllib3, httpx...) being silenced —
# use it when you need to see HTTP calls or model-loading detail.
# LOG_LEVEL=INFO
# DEBUG=false
# LOG_FILE=data/logs/plp.log     # set to "none" to disable file logging

# --- Chatbot backend (chatbot/backends/) ---
# Server-side switch only: the dashboard always calls FastAPI /chat.
# OpenAI is the default, including when CHATBOT_BACKEND is omitted.
# Choose ollama explicitly for local answers, or claude for Claude.
# Missing credentials disable Ask; they never select another provider.
# Restart the API after editing .env.
CHATBOT_BACKEND=openai
# OpenAI key: https://platform.openai.com/api-keys (uses API credit).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible provider, e.g. Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1 with a Groq key above and
#   OPENAI_MODEL=openai/gpt-oss-120b (or llama-3.3-70b-versatile, qwen/qwen3.8-27b)
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
# The intent classifier still uses local Ollama with every answer provider.
# No automatic fallback between providers. Legacy auto-detection is opt-in
# with CHATBOT_BACKEND=auto (Claude, then OpenAI, else Ollama).
