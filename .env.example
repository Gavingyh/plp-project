# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys.
# See API_KEYS.md for step-by-step instructions on getting each key below.

# --- NewsAPI (https://newsapi.org/register) ---
NEWSAPI_KEY=your_newsapi_key_here

# --- Alpha Vantage (https://www.alphavantage.co/support/#api-key) ---
ALPHAVANTAGE_KEY=your_alphavantage_key_here

# --- Reddit (https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent — replace "your_username" below.
REDDIT_USER_AGENT=plp-practice-module/0.1 by u/your_username
