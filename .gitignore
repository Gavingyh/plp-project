data/.search-*/

# service pid files written by scripts/start.sh
data/run/

# data too large for GitHub (100MB file limit); shared as a snapshot instead,
# see "Getting the database" in README.md
data/plp.db
data/plp.db-shm
data/plp.db-wal
data/sentence_embeddings.npz
data/search_embeddings.npz
data/snapshots/

# full-text CNA articles fetched by ingest/cna_archive.py: CNA's copyright, not redistributed
data/cna/
# ... and the scraper's output (ingest/cna_scraper.py --output), the same text
ingest/cna_articles.json

# API keys; copy .env.example to .env
.env

# output of the scheduled daily batch (scripts/com.plp.dailybatch.plist)
# Runtime logs: written on every run, and they hold local paths.
data/logs/*
!data/logs/.gitkeep

# LLM aspect-classifier answer cache (aspects/llm_classify.py)
data/aspect_llm/

# index previews from aggregate/preview.py
data/preview/

# Personal Claude Code notes
CLAUDE.local.md

# Claude Code: personal settings, worktrees, and the latest validation run
# (dated copies are kept in docs/validation/)
.claude/settings.local.json
.claude/worktrees/
/VALIDATION.md
# requests sent to hosted chatbot providers in the last 24 hours (chatbot/ratelimit.py)
data/ratelimit_state.json

# Private notes and course material, kept on the owner's machine.
.project-context/

# Word copies of the report carry the team's names; the master lives on SharePoint
docs/**/*.docx
