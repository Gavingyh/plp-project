          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "sources": {
            "items": {
              "enum": [
                "earnings",
                "sgx_research"
              ],
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "completed_with_warnings",
              "failed",
              "interrupted"
            ],
