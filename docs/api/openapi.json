        },
        "required": [
          "sources"
        ],
        "title": "PipelineSources",
        "type": "object"
      },
      "PipelineStage": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "files": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Files",
            "type": "array"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": true,
            "title": "Metrics",
            "type": "object"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "status",
          "started_at",
          "finished_at",
          "metrics",
          "files",
          "error"
        ],
        "title": "PipelineStage",
        "type": "object"
      },
      "SourceOption": {
        "properties": {
          "exists": {
            "title": "Exists",
            "type": "boolean"
          },
          "folder": {
            "title": "Folder",
            "type": "string"
          },
          "key": {
            "enum": [
              "earnings",
              "sgx_research"
            ],
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "pdf_count": {
            "title": "Pdf Count",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "label",
          "folder",
          "exists",
          "pdf_count"
        ],
        "title": "SourceOption",
        "type": "object"
      },
      "StartPipelineRequest": {
        "additionalProperties": false,
        "properties": {
          "sources": {
            "items": {
              "enum": [
                "earnings",
                "sgx_research"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources"
        ],
        "title": "StartPipelineRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The system's interface: the sentiment index, its evidence, analyst consensus and the chatbot, for any dashboard or client to read. POST /chat calls a model; POST /pipeline/runs starts an incremental PDF pipeline which writes to the database. Other data routes are read-only. Integration guide: docs/api-integration.md.",
    "title": "SG Bank Sentiment API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analyst-consensus": {
      "get": {
        "operationId": "analyst_consensus_analyst_consensus_get",
        "parameters": [
          {
            "in": "query",
            "name": "bank",
            "required": true,
            "schema": {
              "pattern": "^(DBS|OCBC|UOB)$",
              "title": "Bank",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyst Consensus"
      }
    },
    "/analyst-consensus/latest": {
      "get": {
        "description": "Every bank's newest consensus row in one call. Banks are fetched\nseparately and can carry different dates; each bank's own newest row is\nreturned, so a bank fetched a day earlier is never dropped.",
        "operationId": "analyst_consensus_latest_analyst_consensus_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Analyst Consensus Latest"
      }
    },
    "/aspects": {
      "get": {
        "description": "The aspect keys with their readable labels, from config/aspects.yaml, for labelling a UI.",
        "operationId": "aspects_aspects_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Aspects"
      }
    },
    "/banks": {
      "get": {
        "operationId": "banks_banks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Banks"
      }
    },
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/coverage": {
      "get": {
        "operationId": "coverage_coverage_get",
        "parameters": [
          {
            "in": "query",
            "name": "bank",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(DBS|OCBC|UOB)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bank"
            }
          },
          {
            "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
            "in": "query",
            "name": "aspect",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
              "title": "Aspect"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Coverage"
      }
    },
    "/evidence": {
      "get": {
        "operationId": "evidence_evidence_get",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "title": "Query",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "bank",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(DBS|OCBC|UOB)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bank"
            }
          },
          {
            "in": "query",
            "name": "sentiment",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(positive|neutral|negative)$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sentiment"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 50,
              "minimum": 1,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
            "in": "query",
            "name": "aspect",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
              "title": "Aspect"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evidence"
      }
    },
    "/evidence/latest": {
      "get": {
        "description": "The newest sentences for a bank, optionally one aspect, with their stored\nsentiment label: a drill-down list for a dashboard. (`/evidence` is the\nsemantic search the chatbot uses, and needs a query.)",
        "operationId": "evidence_latest_evidence_latest_get",
        "parameters": [
          {
            "in": "query",
            "name": "bank",
            "required": true,
            "schema": {
              "pattern": "^(DBS|OCBC|UOB)$",
              "title": "Bank",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
            "in": "query",
            "name": "aspect",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "An aspect key such as dividend_policy (\"dividend policy\" also works), or ALL / empty for every aspect",
              "title": "Aspect"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evidence Latest"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/pipeline/runs": {
      "get": {
        "description": "Newest run summaries and the active ID, recovering stopped workers' metadata.",
        "operationId": "pipeline_history_pipeline_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineHistory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Pipeline worker or run storage unavailable"
          }
        },
        "summary": "Pipeline History",
        "tags": [
          "pipeline"
        ]
      },
      "post": {
        "description": "Start an incremental PDF run in a separate process and return its queued record.\n\nThis endpoint writes to the configured database. It accepts source keys,\nnot paths, commands or model changes. Poll Location for progress; never\nautomatically retry a POST whose response was lost.",
        "operationId": "start_pipeline_pipeline_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartPipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Another manual pipeline run is active"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "The background worker could not be started"
          }
        },
        "summary": "Start Pipeline",
        "tags": [
          "pipeline"
        ]
      }
    },
    "/pipeline/runs/{run_id}": {
      "get": {
        "description": "Full stage metrics, file outcomes, warnings and import manifest for one run.",
        "operationId": "pipeline_status_pipeline_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
