          "db_path",
          "embeddings_path",
          "model_version",
          "current_stage",
          "log_path",
          "import_candidates",
          "imported_documents",
          "warnings",
          "error",
          "stages"
        ],
        "title": "PipelineRun",
        "type": "object"
      },
      "PipelineRunResponse": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/PipelineRun"
          }
        },
        "required": [
          "run"
        ],
        "title": "PipelineRunResponse",
        "type": "object"
      },
      "PipelineRunSummary": {
        "properties": {
          "current_stage": {
