            "type": "array"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "completed_with_warnings",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Warnings",
            "type": "array"
          },
          "worker_exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Exit Code"
          },
          "worker_log_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Log Path"
          }
        },
        "required": [
          "run_id",
          "status",
          "sources",
          "started_at",
          "finished_at",
